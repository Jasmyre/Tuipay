@startuml
title Tuipay - Core Structure (Model Managers In Services Package)

package "models" {
  class Student {
    - String studentId
    - String username
    - String fullName
    - String password
    - double tuitionBalance
    - double walletBalance
    - List<Transaction> transactions
    + addTransaction(transaction: Transaction)
    + getTransactionHistory(): List<Transaction>
  }

  class Admin {
    - String adminId
    - String username
    - String password
    + authenticate(id: String, password: String): boolean
  }

  class Transaction {
    - String transactionId
    - String studentId
    - TransactionType type
    - double amount
    - Date transactionDate
    - double remainingTuitionBalance
    + generateReceipt(): String
  }

  enum TransactionType {
    TOP_UP
    TUITION_PAYMENT
  }
}

package "services" {
  class AppManagerService {
    - StudentManager studentManager
    - TransactionManager transactionManager
    - AdminManager adminManager
    - String currentAccountId
    - String currentAccountRole
    + initializeManagers()
    + getStudentManager(): StudentManager
    + getTransactionManager(): TransactionManager
    + getAdminManager(): AdminManager
    + setCurrentAccount(accountId: String, role: String)
    + getCurrentAccountId(): String
    + getCurrentAccountRole(): String
    + clearCurrentAccount()
  }

  class StudentManager {
    + getAllStudents(): List<Student>
    + findStudentById(studentId: String): Student
    + topUpWallet(student: Student, amount: double)
    + payTuition(student: Student, amount: double): boolean
    + updateTuitionBalance(studentId: String, amount: double)
  }

  class TransactionManager {
    + createTopUpTransaction(student: Student, amount: double): Transaction
    + createPaymentTransaction(student: Student, amount: double): Transaction
    + getAllTransactions(students: List<Student>): List<Transaction>
  }

  class AdminManager {
    + getAdmin(): Admin
    + viewStudentRecords(): List<Student>
    + viewAllTransactions(): List<Transaction>
  }
}

package "core" {
  class App
  class TestDataSeeder {
    + seed(services: AppManagerService)
  }
}

package "pages" {
  class AppFrame
  class LoginPage
  class HomePage
  class ManageStudentsPage
  class TopUpPage
  class PayTuitionPage
  class TransactionHistoryPage
  class ViewTransactionsPage
  class UpdateTuitionPage
}

Student "1" *-- "*" Transaction
Transaction --> TransactionType

StudentManager --> Student
StudentManager --> TransactionManager
TransactionManager --> Transaction
AdminManager --> Admin
AdminManager --> Student
AdminManager --> TransactionManager
AppManagerService --> StudentManager
AppManagerService --> TransactionManager
AppManagerService --> AdminManager
AppManagerService --> Student
AppManagerService --> Admin

App --> AppManagerService
TestDataSeeder --> AppManagerService

AppFrame --> AppManagerService
AppFrame --> LoginPage

HomePage --> AppManagerService
ManageStudentsPage --> AppManagerService
TopUpPage --> AppManagerService
PayTuitionPage --> AppManagerService
TransactionHistoryPage --> AppManagerService
ViewTransactionsPage --> AppManagerService
UpdateTuitionPage --> AppManagerService

note right of LoginPage
Authentication stays in LoginPage
(no AuthService/AuthManager in services).
end note

@enduml
