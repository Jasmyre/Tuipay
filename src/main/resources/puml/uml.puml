@startuml
title Tuipay - System UML (Models + Services + Core Flow)

skinparam packageStyle rectangle

' =======================
' MODELS
' =======================
package "models" {

  class Student {
    - String studentId
    - String username
    - String fullName
    - String password
    - double tuitionBalance
    - double walletBalance
    - List<Transaction> transactions
    + topUp(amount: double)
    + payTuition(amount: double)
    + addTransaction(t: Transaction)
    + getTransactionHistory(): List<Transaction>
  }

  class Admin {
    - String adminId
    - String username
    - String password
    + authenticate(id: String, password: String): boolean
  }

  class Transaction {
    - String transactionId
    - String studentId
    - TransactionType type
    - double amount
    - Date transactionDate
    - double remainingTuitionBalance
    + generateReceipt(): String
  }

  enum TransactionType {
    TOP_UP
    TUITION_PAYMENT
  }

  Student "1" --> "*" Transaction
}

' =======================
' SERVICES
' =======================
package "services" {

  class AppServices {
    - StudentManager studentManager
    - TransactionManager transactionManager
    - AdminManager adminManager
    - String currentAccountId
    - String currentAccountRole
    + initializeManagers()
    + setCurrentAccount(id: String, role: String)
    + clearCurrentAccount()
  }

  class StudentManager {
    + getAllStudents(): List<Student>
    + findStudentById(id: String): Student
    + topUpWallet(student: Student, amount: double)
    + payTuition(student: Student, amount: double): boolean
  }

  class TransactionManager {
    + createTopUpTransaction(student: Student, amount: double): Transaction
    + createPaymentTransaction(student: Student, amount: double): Transaction
    + getAllTransactions(): List<Transaction>
  }

  class AdminManager {
    + getAdmin(): Admin
    + viewStudents(): List<Student>
    + viewTransactions(): List<Transaction>
  }

  AppServices --> StudentManager
  AppServices --> TransactionManager
  AppServices --> AdminManager

  StudentManager --> Student
  TransactionManager --> Transaction
  AdminManager --> Admin
  AdminManager --> Student
  AdminManager --> Transaction
}

' =======================
' UI LAYER (PAGES)
' =======================
package "pages (Swing UI)" {

  class AppFrame {
    + switchPage(name: String)
  }

  class HomePage
  class StudentPage
  class TransactionPage
  class AdminPage
  class ReportsPage

  AppFrame --> HomePage
  AppFrame --> StudentPage
  AppFrame --> TransactionPage
  AppFrame --> AdminPage
  AppFrame --> ReportsPage

  HomePage --> StudentManager
  HomePage --> TransactionManager

  StudentPage --> StudentManager
  TransactionPage --> TransactionManager
  AdminPage --> AdminManager
  AdminPage --> StudentManager
  AdminPage --> TransactionManager
  ReportsPage --> StudentManager
  ReportsPage --> TransactionManager
}

' =======================
' BOOTSTRAP
' =======================
class App {
  + main()
}

class TestDataSeeder {
  + seed(AppServices)
}

App --> AppServices
App --> TestDataSeeder
TestDataSeeder --> StudentManager
TestDataSeeder --> TransactionManager

@enduml