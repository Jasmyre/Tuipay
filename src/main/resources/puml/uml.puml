@startuml
title Tuipay - Core Structure (Based on Documented Functionalities)

package "models" {

  class Student {
    - String studentId
    - String username
    - String fullName
    - String password
    - double tuitionBalance
    - double walletBalance
    - List<Transaction> transactions

    + topUp(amount: double)
    + payTuition(amount: double): boolean
    + addTransaction(transaction: Transaction)
    + getTransactionHistory(): List<Transaction>
  }

  class Admin {
    - String adminId
    - String username
    - String password

    + authenticate(id: String, password: String): boolean
  }

  class Transaction {
    - String transactionId
    - String studentId
    - TransactionType type
    - double amount
    - Date transactionDate
    - double remainingTuitionBalance

    + generateReceipt(): String
  }

  enum TransactionType {
    TOP_UP
    TUITION_PAYMENT
  }
}

package "services" {

  class SeedDataService {
    + seedStudents(): List<Student>
    + seedAdmin(): Admin
  }

  class AuthService {
    - List<Student> students
    - Admin admin

    + login(id: String, password: String): Object
    + logout()
  }

  class StudentService {
    + viewStudentDashboard(student: Student): StudentDashboardDTO
    + topUpWallet(student: Student, amount: double)
    + payTuition(student: Student, amount: double): boolean
    + getPaymentHistory(student: Student): List<Transaction>
  }

  class AdminService {
    - List<Student> students

    + viewAdminDashboard(): AdminDashboardDTO
    + getAllStudents(): List<Student>
    + getAllTransactions(): List<Transaction>
    + updateTuitionBalance(studentId: String, amount: double)
  }

  class SessionService {
    - Student currentStudent
    - Admin currentAdmin

    + setCurrentStudent(student: Student)
    + getCurrentStudent(): Student
    + setCurrentAdmin(admin: Admin)
    + getCurrentAdmin(): Admin
    + clearSession()
  }

  class TransactionService {
    + createTopUpTransaction(student: Student, amount: double): Transaction
    + createPaymentTransaction(student: Student, amount: double): Transaction
    + getAllTransactions(students: List<Student>): List<Transaction>
  }

  class TemporaryStorageService {
    - List<Student> students
    - Admin admin
    - Map<String, Object> sessionData

    + initializeSeedData()
    + resetOnAppClose()
  }
}

package "pages" {
  class AppFrame
  class HomePage
  class ManageStudentsPage
  class ViewTransactionsPage
  class UpdateTuitionPage
  class TopUpPage
  class PayTuitionPage
  class TransactionHistoryPage
}

package "dto" {
  class StudentDashboardDTO {
    + String fullName
    + String studentId
    + double tuitionBalance
    + double walletBalance
  }

  class AdminDashboardDTO {
    + int totalStudents
    + double totalPaymentsMade
    + double totalRemainingBalances
  }
}

package "constraints" {
  note "Demo Prototype Limitations:\n- No real payment gateway integration\n- No real database persistence\n- Session-based temporary data only\n- Seeded accounts only\n- No registration/forgot-password flow" as DemoLimitations
}

Student "1" *-- "*" Transaction
Transaction --> TransactionType

SeedDataService --> Student
SeedDataService --> Admin

AuthService --> Student
AuthService --> Admin
AuthService --> SessionService

StudentService --> Student
StudentService --> TransactionService
StudentService --> StudentDashboardDTO

AdminService --> Student
AdminService --> TransactionService
AdminService --> AdminDashboardDTO

SessionService --> Student
SessionService --> Admin

TransactionService --> Transaction
TransactionService --> Student

TemporaryStorageService --> SeedDataService
TemporaryStorageService --> Student
TemporaryStorageService --> Admin
DemoLimitations .. TemporaryStorageService

AppFrame --> AuthService
AppFrame --> SessionService
AppFrame --> StudentService
AppFrame --> AdminService
AppFrame --> TransactionService
AppFrame --> TemporaryStorageService

HomePage --> StudentService
HomePage --> SessionService
ManageStudentsPage --> AdminService
ViewTransactionsPage --> TransactionService
ViewTransactionsPage --> TemporaryStorageService
UpdateTuitionPage --> AdminService
TopUpPage --> SessionService
PayTuitionPage --> SessionService
TransactionHistoryPage --> StudentService
TransactionHistoryPage --> SessionService

@enduml
